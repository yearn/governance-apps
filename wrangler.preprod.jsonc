{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "governance-apps-preprod",
  "main": ".open-next/worker.js",

  "compatibility_date": "2026-01-22",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "preview_urls": true,

  "routes": [
    { "pattern": "styfi-beta.dao-ops.com", "custom_domain": true },
    { "pattern": "veyfi-beta.dao-ops.com", "custom_domain": true },
    { "pattern": "teams-beta.dao-ops.com", "custom_domain": true },
    { "pattern": "yeth-beta.dao-ops.com", "custom_domain": true },
    { "pattern": "ybc-beta.dao-ops.com", "custom_domain": true }
  ],

  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },

  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "governance-apps-preprod"
    }
  ]
}
